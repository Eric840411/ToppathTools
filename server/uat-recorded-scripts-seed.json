        "tableId": "tbl2DZXAMxWdNen0",
        "bindings": [
          {
            "recordId": "recvuBTwMT4h9g",
            "tableId": "tbl2DZXAMxWdNen0",
            "number": "T-A-005",
            "text": "確認日期可以選擇(當日)，Game Type搜尋機型正確，Player Channel篩選正確，選擇All會顯示所有平台的數據，可導出Excel表",
            "sub": "Egm DayCount"
          }
        ],
        "steps": [
          {
            "action": "open_page",
            "tcId": "recvuBTwMT4h9g",
            "path": "/egm/reports/gameCount",
            "waitMs": 4000
          },
          {
            "action": "type_text",
            "tcId": "recvuBTwMT4h9g",
            "selector": ".el-date-editor:not(.dd) input",
            "value": "2026-09-01"
          },
          {
            "action": "keypress",
            "tcId": "recvuBTwMT4h9g",
            "selector": ".el-date-editor:not(.dd) input",
            "key": "Enter"
          },
          {
            "action": "type_text",
            "tcId": "recvuBTwMT4h9g",
            "selector": ".el-date-editor.dd input",
            "value": "2026-09-20"
          },
          {
            "action": "keypress",
            "tcId": "recvuBTwMT4h9g",
            "selector": ".el-date-editor.dd input",
            "key": "Enter"
          },
          {
            "action": "keypress",
            "tcId": "recvuBTwMT4h9g",
            "key": "Escape"
          },
          {
            "action": "submit_search",
            "tcId": "recvuBTwMT4h9g",
            "waitMs": 9000
          },
          {
            "action": "read_table",
            "tcId": "recvuBTwMT4h9g",
            "selector": ".el-table",
            "as": "screen",
            "maxRows": 5
          },
          {
            "action": "read_export",
            "tcId": "recvuBTwMT4h9g",
            "as": "xls",
            "timeoutMs": 20000
          },
          {
            "action": "assert_equals",
            "tcId": "recvuBTwMT4h9g",
            "left": "xls.0.TotalOnlineTransferInAmount",
            "right": "screen.0.TotalOnlineTransferInAmount",
            "tolerancePct": 0,
            "absoluteTolerance": 0
          },
          {
            "action": "assert_equals",
            "tcId": "recvuBTwMT4h9g",
            "left": "xls.0.TotalOnlineTransferOutAmount",
            "right": "screen.0.TotalOnlineTransferOutAmount",
            "tolerancePct": 0,
            "absoluteTolerance": 0
          },
          {
            "action": "assert_equals",
            "tcId": "recvuBTwMT4h9g",
            "left": "xls.0.TotalBetUser",
            "right": "screen.0.TotalBetUser",
            "tolerancePct": 0,
            "absoluteTolerance": 0
          },
          {
            "action": "assert_equals",
            "tcId": "recvuBTwMT4h9g",
            "left": "xls.0.TotalBetAmount",
            "right": "screen.0.TotalBetAmount",
            "tolerancePct": 0,
            "absoluteTolerance": 0
          },
          {
            "action": "assert_equals",
            "tcId": "recvuBTwMT4h9g",
            "left": "xls.0.TotalWinOrLoseAmount",
            "right": "screen.0.TotalWinOrLoseAmount",
            "tolerancePct": 0,
            "absoluteTolerance": 0
          },
          {
            "action": "screenshot",
            "tcId": "recvuBTwMT4h9g",
            "name": "daycount_export_vs_screen"
          }
        ]
      }
    },
